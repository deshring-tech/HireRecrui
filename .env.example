# --- Supabase (database + file storage) ---
# Leave these unset to run fully local (JSON file DB + local uploads folder).
# Set both to switch the app to Supabase Postgres + Supabase Storage.
# Find them in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name (created by supabase/schema.sql; default "uploads")
SUPABASE_STORAGE_BUCKET=uploads

# --- AI (optional) ---
# Without a key the app uses its built-in algorithmic engine (skills extraction,
# scoring, Q&A) — fully functional, just not LLM-generated.
OPENAI_API_KEY=

# --- Email (optional) ---
# Without a key, emails are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="HireFlow AI <onboarding@resend.dev>"

# --- Launch / admin ---
# Comma-separated emails allowed to open /admin (usage stats). Empty = page disabled.
ADMIN_EMAILS=
# The number of recruiters returning in week 2 you've pre-committed to as "it's working".
LAUNCH_GOAL_RETAINED_RECRUITERS=10
# Shown publicly on the Privacy/Terms pages and footer. Use an address you're happy to publish.
NEXT_PUBLIC_CONTACT_EMAIL=
